    {
      "parameters": {
        "method": "POST",
        "url": "https://api.wavespeed.ai/api/v2/kling/kling-v3-0-image-to-video",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WAVESPEED_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"inputs\": {\n    \"image\": \"{{ $('Build Image URL').item.json.imageUrl }}\",\n    \"prompt\": \"{{ $('Build Image URL').item.json.prompt }}\",\n    \"duration\": 15,\n    \"aspect_ratio\": \"9:16\",\n    \"cfg_scale\": 0.5\n  },\n  \"enable_safety_checker\": false\n}"
      },
      "id": "iv000008-0000-0000-0000-000000000008",
      "name": "Submit Kling Job",

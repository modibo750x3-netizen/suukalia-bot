    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "is-video-cmd",
              "leftValue": "={{ $json.message.text }}",
              "rightValue": "^/video[2-8]?$",
              "operator": { "type": "string", "operation": "regex" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "iv000002-0000-0000-0000-000000000002",
      "name": "Is /video Command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-reply-photo",
              "leftValue": "={{ !!$json.message.reply_to_message?.photo }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "iv000003-0000-0000-0000-000000000003",
      "name": "Has Reply Photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.1,
      "position": [640, 220]
    },
    {
      "parameters": {
        "jsCode": "const cmd = $input.item.json.message.text.trim();\nconst chatId = String($input.item.json.message.chat.id);\n\nconst motions = {\n  '/video':  'twerking, slow bounce, low angle, hypnotic rhythm',\n  '/video2': 'on all fours, looking directly at camera, slow crawl',\n  '/video3': 'sitting on floor, legs spread, leaning back on hands',\n  '/video4': 'squatting slowly, hands resting on knees, seductive gaze',\n  '/video5': 'lying on bed, slow full body roll, tangled in sheets',\n  '/video6': 'standing, hands slowly running down body from neck to hips',\n  '/video7': 'arching back, dramatic hair flip, look over shoulder',\n  '/video8': 'walking toward camera slowly, confident strut, direct eye contact',\n};\n\nconst outfits = [\n  'tiny triangle bikini',\n  'black lace lingerie',\n  'high cut bodysuit',\n  'sheer mesh outfit',\n  'sports bra and booty shorts',\n  'silk bralette and thong',\n];\n\nconst motion = motions[cmd] || motions['/video'];\nconst outfit = outfits[Math.floor(Math.random() * outfits.length)];\n\nconst photos = $input.item.json.message.reply_to_message.photo;\nconst fileId = photos[photos.length - 1].file_id;\n\nconst prompt = [\n  `Mixed woman, voluminous curly black hair, warm golden brown skin,`,\n  `hourglass figure, slim waist, 1m68.`,\n  `Wearing ${outfit}.`,\n  `${motion}.`,\n  `Pink neon lighting, penthouse setting.`,\n  `Cinematic slow motion, low angle camera, 4K, ultra-realistic, seamless loop.`,\n].join(' ');\n\nreturn { fileId, chatId, prompt, motion, outfit };"
      },
      "id": "iv000004-0000-0000-0000-000000000004",
      "name": "Parse Command & Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 140]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getFile",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "file_id", "value": "={{ $json.fileId }}" }
          ]
        }
      },
      "id": "iv000005-0000-0000-0000-000000000005",
      "name": "Get File Path",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 140]
    },

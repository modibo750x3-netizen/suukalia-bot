              "value": "=https://api.telegram.org/file/bot{{ $env.TELEGRAM_BOT_TOKEN }}/{{ $json.result.file_path }}"
            },
            { "name": "chatId", "value": "={{ $('Parse Command & Build Prompt').item.json.chatId }}" },
            { "name": "prompt", "value": "={{ $('Parse Command & Build Prompt').item.json.prompt }}" }
          ]
        }
      },

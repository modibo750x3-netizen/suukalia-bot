            {
              "id": "check-done-1",
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "succeeded",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "fa000010-0000-0000-0000-000000000010",
      "name": "Done? (1)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.1,
      "position": [2180, 220]
    },
    {
      "parameters": {
        "chatId": "={{ $('Save Prediction ID').item.json.chatId }}",
        "operation": "sendPhoto",
        "photoUrl": "={{ $json.data.outputs[0] }}",
        "additionalFields": {}
      },
      "id": "fa000011-0000-0000-0000-000000000011",
      "name": "Send Result",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2400, 140],

{
  "name": "Suukalia — 1. Face Swap",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "fa000001-0000-0000-0000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [200, 300],
      "webhookId": "suukalia-faceswap-trigger",
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-photo",
              "leftValue": "={{ !!$json.message.photo }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "fa000002-0000-0000-0000-000000000002",
      "name": "Has Photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const photos = $input.item.json.message.photo;\nconst largest = photos[photos.length - 1];\nreturn {\n  fileId: largest.file_id,\n  chatId: String($input.item.json.message.chat.id),\n  messageId: $input.item.json.message.message_id\n};"
      },
      "id": "fa000003-0000-0000-0000-000000000003",
      "name": "Extract File ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 220]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getFile",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "file_id", "value": "={{ $json.fileId }}" }
          ]
        }
      },
      "id": "fa000004-0000-0000-0000-000000000004",
      "name": "Get File Path",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 220]
    },
    {
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "faceImageUrl",
              "value": "=https://api.telegram.org/file/bot{{ $env.TELEGRAM_BOT_TOKEN }}/{{ $json.result.file_path }}"
            },
            {
              "name": "chatId",
              "value": "={{ $('Extract File ID').item.json.chatId }}"
            }
          ]
        }
      },
      "id": "fa000005-0000-0000-0000-000000000005",
      "name": "Build Image URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1080, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.wavespeed.ai/api/v2/wavespeed-ai/nano-banana-2",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WAVESPEED_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"inputs\": {\n    \"face_image\": \"{{ $json.faceImageUrl }}\",\n    \"target_image\": \"{{ $env.REFERENCE_IMAGE_URL }}\"\n  },\n  \"enable_safety_checker\": false\n}"
      },
      "id": "fa000006-0000-0000-0000-000000000006",
      "name": "Submit Face Swap",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 220]
    },
    {
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            { "name": "predictionId", "value": "={{ $json.data.id }}" },
            { "name": "chatId", "value": "={{ $('Build Image URL').item.json.chatId }}" }
          ]
        }
      },
      "id": "fa000007-0000-0000-0000-000000000007",
      "name": "Save Prediction ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1520, 220]
    },
    {
      "parameters": { "amount": 25, "unit": "seconds" },
      "id": "fa000008-0000-0000-0000-000000000008",
      "name": "Wait 25s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1740, 220]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.wavespeed.ai/api/v2/predictions/{{ $json.predictionId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WAVESPEED_API_KEY }}" }
          ]
        }
      },
      "id": "fa000009-0000-0000-0000-000000000009",
      "name": "Poll Result 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1960, 220]

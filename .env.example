# ─── Suukalia Bot — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Telegram Bot Token — get it from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key — get it from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Instagram Session (optional — for /analyse and /inspire) ────────────────
# Without these, Playwright may hit Instagram's login wall.
# To get these values: open instagram.com in Chrome, DevTools → Application →
# Cookies → instagram.com → copy 'sessionid' and 'ds_user_id' values.
IG_SESSION_ID=your_sessionid_cookie_value_here
IG_DS_USER_ID=your_ds_user_id_cookie_value_here

# ─── n8n Workflows ────────────────────────────────────────────────────────────

# Wavespeed API Key — get it from https://wavespeed.ai
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# Reference image URL for face swap (workflow 1)
# The target body image that the user's face will be swapped onto
REFERENCE_IMAGE_URL=https://your-cdn.com/suukalia-reference.jpg
